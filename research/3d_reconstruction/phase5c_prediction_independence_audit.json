  "root_cause_findings": [
    {
      "finding_id": "FINDING_UNTRAINED_BASELINES",
      "severity": "CRITICAL_METHODOLOGICAL_DEFECT",
      "description": "In scripts/3d_reconstruction/evaluate_phase5b_baselines_oracle.py, FrontalOnlyShapePredictor, LateralOnlyShapePredictor, and DualViewConcatShapePredictor were instantiated with untrained default PyTorch random weights because no trained checkpoints existed for them on disk. Their output projection layers initialized near zero produced coefficient vectors with tiny L2 norms (Frontal: 1.7731, Lateral: 1.4681, Concat: 1.5515) compared to true shape variations (Trained Phase 5 Attention: 42.7313, Trained Phase 5B V2: 66.4527). Consequently, the predicted shapes for all three baseline models remained within <0.02 mm of the population mean shape.",
      "impact": "Frontal-only, lateral-only, and concat baselines did NOT reflect their true architectural capability. They collapsed to the mean shape prior (ASSD ~5.084 mm) solely due to absent checkpoint weights."
    },
    {
      "finding_id": "FINDING_INDEPENDENCE_VERIFIED_FOR_TRAINED_MODELS",
      "severity": "INFORMATIONAL_VERIFIED",
      "description": "Phase 5 Attention and Phase 5B V2 Heteroscedastic models possess genuine trained weights, each producing 65 distinct prediction hashes across the 65 test patients. Pairwise coefficient distance between Phase 5 Attention and Phase 5B V2 is non-zero (mean L2 dist = 28.9319), confirming that predictions are independent and not cached or copied.",
      "impact": "The Phase 5B V2 architecture produces truly novel, patient-specific 3D lung surfaces distinct from both the mean shape and prior Phase 5 predictions."
    },
    {
      "finding_id": "FINDING_SILENT_MEAN_COLLAPSE_IDENTIFIED",
      "severity": "CONFIRMED_AUDIT_EXPLANATION",
      "description": "The reported Phase 5B table showing near-identical metrics (5.0844 vs 5.0836 vs 5.0839 vs 5.0840) was entirely an artifact of evaluating untrained models that defaulted to the zero-coefficient mean shape.",
      "impact": "Answers Task A conclusively: the nearly identical baseline performance was caused by missing trained checkpoints for the ablation baselines, not by a theoretical ceiling of the frontal or lateral modalities."
    }
  ],
